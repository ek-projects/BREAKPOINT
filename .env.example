# Required for the hackathon runtime call to Nebius Token Factory.
NEBIUS_API_KEY=

# NVIDIA open model on Nebius Token Factory.
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Low-latency structured-output defaults for Nemotron 3.5 Lightning.
NEBIUS_MAX_TOKENS=192
NEBIUS_ENABLE_THINKING=false
